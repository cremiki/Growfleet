# ---------------------------------------------------------------
# flespi
# ---------------------------------------------------------------
# Token flespi di tipo ACL in sola lettura (gw/devices, ID all, metodo GET). Resta sempre sul server.
# Verificalo dalla pagina "Collegamento flespi" dell'app.
# Se lasciato vuoto, l'app parte in MODALITÀ DEMO con veicoli simulati.
FLESPI_TOKEN=

# Forza la modalità demo anche se FLESPI_TOKEN è impostato (1 = demo)
FLESPI_MOCK=

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
# Postgres (Neon su Vercel, oppure Postgres/TimescaleDB sulla VPS).
# Se vuoto, in locale usa un Postgres embedded (PGlite) salvato in ./.data/pglite
DATABASE_URL=

# ---------------------------------------------------------------
# Autenticazione
# ---------------------------------------------------------------
# Chiave per firmare i cookie di sessione (min 32 caratteri). Genera con: openssl rand -base64 48
AUTH_SECRET=

# Primo amministratore: creato automaticamente al primo avvio se nel DB non c'è nessun utente
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------
# Mappe
# ---------------------------------------------------------------
# Chiave Google Maps JavaScript API (facoltativa: senza chiave è disponibile solo OpenStreetMap)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID Google (necessario per gli Advanced Markers). Se vuoto usa DEMO_MAP_ID
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Intervallo di aggiornamento della mappa live, in secondi
NEXT_PUBLIC_LIVE_REFRESH_SECONDS=10

# ---------------------------------------------------------------
# Supporto (pagina Aiuto)
# ---------------------------------------------------------------
SUPPORT_EMAIL=
SUPPORT_PHONE=
